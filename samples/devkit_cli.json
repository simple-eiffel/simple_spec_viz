{
  "name": "DevKit CLI",
  "version": "0.1.0",

  "states": [
    {
      "id": "S-001",
      "name": "idle",
      "description": "Application waiting for input",
      "is_initial": true,
      "screen": "SCR-001",
      "entry_actions": ["show_prompt"],
      "exit_actions": ["clear_prompt"]
    },
    {
      "id": "S-002",
      "name": "processing",
      "description": "Command executing",
      "screen": "SCR-002"
    },
    {
      "id": "S-003",
      "name": "complete",
      "description": "Command finished successfully",
      "screen": "SCR-003",
      "is_final": true
    },
    {
      "id": "S-004",
      "name": "error",
      "description": "Command failed with error",
      "screen": "SCR-004"
    }
  ],

  "transitions": [
    {
      "id": "T-001",
      "event": "run_command",
      "from": "S-001",
      "to": "S-002",
      "label": "user invokes command",
      "requirements": ["FR-001", "UC-001"]
    },
    {
      "id": "T-002",
      "event": "success",
      "from": "S-002",
      "to": "S-003",
      "label": "command succeeds",
      "requirements": ["FR-002"]
    },
    {
      "id": "T-003",
      "event": "failure",
      "from": "S-002",
      "to": "S-004",
      "label": "command fails",
      "requirements": ["FR-003"]
    },
    {
      "id": "T-004",
      "event": "retry",
      "from": "S-004",
      "to": "S-001",
      "label": "user retries"
    },
    {
      "id": "T-005",
      "event": "new_command",
      "from": "S-003",
      "to": "S-001",
      "label": "start new command"
    }
  ],

  "screens": [
    {
      "id": "SCR-001",
      "name": "Main Prompt",
      "description": "CLI prompt awaiting input",
      "widgets": [
        {"type": "text", "id": "prompt_label", "label": "devkit>", "x": 10, "y": 10},
        {"type": "text_field", "id": "command_input", "placeholder": "Enter command", "x": 80, "y": 10, "width": 400},
        {"type": "button", "id": "run_btn", "label": "Run", "x": 490, "y": 10, "width": 60},
        {"type": "text", "id": "help_hint", "label": "Type 'help' for available commands", "x": 10, "y": 50}
      ],
      "requirements": ["FR-020"]
    },
    {
      "id": "SCR-002",
      "name": "Processing View",
      "description": "Shows command execution progress",
      "widgets": [
        {"type": "text", "id": "status_label", "label": "Processing...", "x": 10, "y": 10},
        {"type": "progress_bar", "id": "progress", "x": 10, "y": 40, "width": 400},
        {"type": "text", "id": "output_area", "label": "[command output]", "x": 10, "y": 80}
      ],
      "requirements": ["FR-021"]
    },
    {
      "id": "SCR-003",
      "name": "Success View",
      "description": "Command completed successfully",
      "widgets": [
        {"type": "text", "id": "success_icon", "label": "[OK]", "x": 10, "y": 10},
        {"type": "text", "id": "result_label", "label": "Command completed successfully", "x": 50, "y": 10},
        {"type": "text", "id": "output_area", "label": "[result output]", "x": 10, "y": 50},
        {"type": "button", "id": "continue_btn", "label": "Continue", "x": 10, "y": 120, "width": 100}
      ],
      "requirements": ["FR-022"]
    },
    {
      "id": "SCR-004",
      "name": "Error View",
      "description": "Command failed with error",
      "widgets": [
        {"type": "text", "id": "error_icon", "label": "[ERROR]", "x": 10, "y": 10},
        {"type": "text", "id": "error_label", "label": "Command failed", "x": 70, "y": 10},
        {"type": "text", "id": "error_details", "label": "[error details]", "x": 10, "y": 50},
        {"type": "button", "id": "retry_btn", "label": "Retry", "x": 10, "y": 120, "width": 80},
        {"type": "button", "id": "cancel_btn", "label": "Cancel", "x": 100, "y": 120, "width": 80}
      ],
      "requirements": ["FR-023"]
    }
  ],

  "traceability": {
    "requirements_to_states": {
      "FR-001": ["S-001", "S-002"],
      "FR-002": ["S-002", "S-003"],
      "FR-003": ["S-002", "S-004"],
      "UC-001": ["S-001", "T-001", "S-002"]
    },
    "states_to_screens": {
      "S-001": "SCR-001",
      "S-002": "SCR-002",
      "S-003": "SCR-003",
      "S-004": "SCR-004"
    }
  }
}
